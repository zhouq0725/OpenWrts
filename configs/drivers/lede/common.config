## Wireless (Intel + x86 merged)

# Core 802.11 Wireless Support (x86)
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

## Intel WiFi Drivers
CONFIG_PACKAGE_kmod-iwlwifi=y
CONFIG_PACKAGE_kmod-iwldvm=y
CONFIG_PACKAGE_kmod-iwlmvm=y

## Intel WiFi Firmware
CONFIG_PACKAGE_iwl-ucode=y
CONFIG_PACKAGE_iwl3160-ucode=y
CONFIG_PACKAGE_iwl6000g2-ucode=y
CONFIG_PACKAGE_iwl6000g2a-ucode=y
CONFIG_PACKAGE_iwl6000g2b-ucode=y
CONFIG_PACKAGE_iwl6050-ucode=y
CONFIG_PACKAGE_iwl7260-ucode=y
CONFIG_PACKAGE_iwl8000c-ucode=y
CONFIG_PACKAGE_iwl8265-ucode=y

## Wireless Configuration Tools
# CONFIG_PACKAGE_iw is not set
CONFIG_PACKAGE_wpa-supplicant=y
CONFIG_PACKAGE_wpa-supplicant-openssl=y
CONFIG_PACKAGE_wpa-cli=y
CONFIG_PACKAGE_hostapd=y
CONFIG_PACKAGE_hostapd-openssl=y

## Additional Wireless Utilities
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_crda=y
CONFIG_PACKAGE_iw-full=y
